APP_NAME=ShoeFlow ERP
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# 正式开发使用 MySQL；请根据本机账号修改用户名和密码。
DATABASE_URL=mysql+pymysql://shoeflow:change_me@127.0.0.1:3306/shoeflow?charset=utf8mb4
DB_ECHO=false

# DeepSeek Agent：API Key 仅保存在后端，不得写入移动端或提交到版本库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
AGENT_ACTION_EXPIRE_MINUTES=15

# ERP 操作手册 RAG；默认值即可直接运行。
RAG_KNOWLEDGE_DIR=knowledge/erp_manual
RAG_DEFAULT_TOP_K=3
RAG_MIN_SCORE=0.08
RAG_MAX_CHUNK_CHARS=1400
